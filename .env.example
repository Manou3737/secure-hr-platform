# Django
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=postgres
DB_NAME=secure_hr
DB_USER=secure_hr_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

# Bank data encryption
BANK_ENCRYPTION_KEY=replace-with-your-existing-fernet-key

# PostgreSQL container
POSTGRES_DB=secure_hr
POSTGRES_USER=secure_hr_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
