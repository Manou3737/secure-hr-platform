# Django
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=postgres
DB_NAME=secure_hr
DB_USER=secure_hr_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

# Bank data encryption
BANK_ENCRYPTION_KEY=replace-with-your-existing-fernet-key
# Previous Fernet keys, comma-separated (optional; used during key rotation)
BANK_ENCRYPTION_OLD_KEYS=

# PostgreSQL container
POSTGRES_DB=secure_hr
POSTGRES_USER=secure_hr_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Private HR document storage (Amazon S3)

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
